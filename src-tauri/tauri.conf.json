{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qaqash",
  "version": "0.1.0",
  "identifier": "dev.elshanx.qaqash",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "width": 370,
        "height": 38,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
